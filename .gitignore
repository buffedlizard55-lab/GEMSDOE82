# Local heavy dataset, memmap & 1,026-raster caches
.cache/
data/raw/
data/cache/
data/rasters/
data/registry/

# Python bytecode & test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS & temporary scratch
.DS_Store
*.log
*.tmp
*.mmap
*.part-*
data/raw/
data/processed/
data/external/
data/registry/
data/scored/
data/*.tif
data/*.npy
work/
evidence/*.npy
registry/rasters/*.tif

# Keep small official bridge templates & JSON manifests tracked
!data/bridge/
!data/bridge/*.tif
!data/*.json
!docs/downloads/*.tif
!docs/downloads/*.zip
!docs/downloads/*.json
!submissions/*.tif
!submissions/*.zip
!submissions/*.json
